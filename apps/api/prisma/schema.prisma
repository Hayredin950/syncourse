// Syncourse — Prisma schema
// Postgres (Neon) — production database. Local dev can point DATABASE_URL
// at a local Postgres or the same Neon project.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------

model Category {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  icon       String   @default("📚")
  coverImage String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  courses CourseCategory[]
  taste   TasteProfile[]
}

model Lecturer {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  photoUrl    String?
  bio         String?
  credentials String?
  socialLinks String   @default("{}") // JSON: { "twitter": ..., "github": ... }
  createdAt   DateTime @default(now())

  courses Course[]
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  orgType     String   @default("publisher") // university | company | publisher
  subscribers Int      @default(0)
  createdAt   DateTime @default(now())

  courses Course[]
}

model Level {
  id       String   @id @default(cuid())
  name     String   @unique // Beginner / Intermediate / Advanced / All Levels
  courses  Course[]
}

model Course {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  description      String
  thumbnailUrl     String?
  bannerUrl        String?
  previewVideoUrl  String?
  language         String    @default("English")
  levelId          String?
  level            Level?    @relation(fields: [levelId], references: [id])
  lecturerId       String?
  lecturer         Lecturer? @relation(fields: [lecturerId], references: [id])
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  originalPrice    Float?
  price            Float?
  isPremium        Boolean   @default(false)
  isFeatured       Boolean   @default(false)
  contentType      String    @default("course") // course | mini-course | cheat-sheet | roadmap
  prerequisites    String?
  ratingAvg        Float     @default(0)
  ratingCount      Int       @default(0)
  enrollmentCount  Int       @default(0)
  downloadCount    Int       @default(0)
  sourceUrl        String?   // where the course content lives (e.g. t.me/…/id) — set by feed ingestion
  publishedAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime? // soft delete — protects progress history

  @@index([publishedAt])

  categories      CourseCategory[]
  tags            CourseTag[]
  audience        CourseAudience[]
  sections        Section[]
  lessons         Lesson[]
  enrollments     Enrollment[]
  reviews         Review[]
  ratings         Rating[]
  pathCourses     LearningPathCourse[]
  collectionItems CollectionItem[]
  savedBy         SavedCourse[]
  likedBy         LikedCourse[]
  downloadEvents  DownloadEvent[]
  telegramLink    TelegramCourseLink?
}

model CourseCategory {
  courseId   String
  categoryId String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([courseId, categoryId])
}

model CourseTag {
  id       String @id @default(cuid())
  courseId String
  tag      String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model CourseAudience {
  id          String @id @default(cuid())
  courseId    String
  audienceTag String
  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model LearningPath {
  id          String   @id @default(cuid())
  title       String
  description String
  coverUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  courses LearningPathCourse[]
}

model LearningPathCourse {
  pathId   String
  courseId String
  order    Int    @default(0)
  path     LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course   Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([pathId, courseId])
}

// ---------------------------------------------------------------
// Content: sections -> lessons -> notes / files / attachments
// ---------------------------------------------------------------

model Section {
  id         String  @id @default(cuid())
  courseId   String
  title      String
  orderIndex Int     @default(0)
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]
}

model Lesson {
  id            String  @id @default(cuid())
  courseId      String
  sectionId     String?
  title         String
  orderIndex    Int     @default(0)
  type          String  @default("video") // video | article | quiz | notes
  durationSec   Int     @default(0)
  videoUrl      String? // private storage URL — served via signed URL only
  isPreview     Boolean @default(false)
  sourceUrl     String? // t.me message link for this lesson/part — set by feed ingestion
  course        Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section       Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  notes       Note[]
  files       LessonFile[]
  attachments Attachment[]
  progress    LessonProgress[]
  downloads   DownloadEvent[]
}

model LessonFile {
  id            String  @id @default(cuid())
  lessonId      String
  label         String // "1080p" | "720p" | "480p" | "notes_pdf"
  format        String  @default("mp4")
  sizeMb        Float
  durationSec   Int     @default(0)
  codec         String?
  hasSubtitles  Boolean @default(false)
  audio         String?
  isBest        Boolean @default(false)
  lesson        Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Note {
  id            String  @id @default(cuid())
  lessonId      String
  courseId      String
  title         String
  richText      String
  imageUrls     String  @default("[]") // JSON array of image URLs
  pdfUrl        String?
  isCheatsheet  Boolean @default(false)
  lesson        Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        String  @id @default(cuid())
  lessonId  String?
  courseId  String?
  fileUrl   String
  fileType  String
  sizeMb    Float
  lesson    Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------
// Users, auth, social
// ---------------------------------------------------------------

model User {
  id               String    @id @default(cuid())
  name             String
  username         String    @unique
  email            String    @unique
  passwordHash     String?
  avatarUrl        String?
  gender           String?
  isVerified       Boolean   @default(false)
  isStaff          Boolean   @default(false)
  planType         String    @default("free") // free | premium
  planExpiresAt    DateTime?
  telegramId       BigInt?   @unique
  telegramUsername String?
  googleId         String?   @unique
  settings         Json? // autoplayNext etc.
  privacy          Json? // visibility: watchHistory | reviews | watchlist | likes
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  enrollments     Enrollment[]
  ratings         Rating[]
  reviews         Review[]
  lists           CollectionList[]
  savedLists      SavedList[]
  savedCourses    SavedCourse[]
  likedCourses    LikedCourse[]
  following       Follow[] @relation("following")
  followers       Follow[] @relation("followers")
  ownedCircles    Circle[] @relation("circleOwner")
  circleMembers   CircleMember[]
  sessions        Session[]
  taste           TasteProfile[]
  downloads       DownloadEvent[]
  subscriptions   Subscription[]
  reviewUpvotes   ReviewUpvote[]
  notifications   Notification[]
}

model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())
  follower   User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("followers", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
}

model TasteProfile {
  id         String @id @default(cuid())
  userId     String
  categoryId String
  weight     Int    @default(1)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Circle {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation("circleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  members     CircleMember[]

  @@index([ownerId])
}

model CircleMember {
  circleId String
  userId   String
  role     String   @default("member") // owner | member
  joinedAt DateTime @default(now())
  circle   Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([circleId, userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  device    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------
// Learning: enrollments, progress, saved, liked, ratings, reviews
// ---------------------------------------------------------------

model Enrollment {
  id            String   @id @default(cuid())
  userId        String
  courseId      String
  progressPct   Int      @default(0)
  status        String   @default("in_progress") // in_progress | completed
  lastLessonId  String?
  enrolledAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessonProgress LessonProgress[]

  @@index([userId, status])
}

model LessonProgress {
  id         String @id @default(cuid())
  enrollmentId String
  lessonId   String
  completed  Boolean @default(false)
  completedAt DateTime?
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

model SavedCourse {
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
}

model LikedCourse {
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  stars     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Review {
  id               String    @id @default(cuid())
  userId           String
  courseId         String
  body             String
  containsSpoilers Boolean   @default(false)
  parentId         String? // threaded replies
  upvotes          Int       @default(0)
  editedAt         DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parent           Review?   @relation("reviewThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Review[]  @relation("reviewThread")
  upvotedBy        ReviewUpvote[]

  @@index([courseId])
}

model ReviewUpvote {
  userId    String
  reviewId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // telegram_reminder | new_lesson | new_course | system
  title     String
  body      String
  deepLink  String?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ---------------------------------------------------------------
// Collections / lists
// ---------------------------------------------------------------

model CollectionList {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  visibility  String   @default("private") // public | private
  savesCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  items      CollectionItem[]
  savedBy    SavedList[]
}

model CollectionItem {
  listId   String
  courseId String
  addedAt  DateTime @default(now())
  list     CollectionList @relation(fields: [listId], references: [id], onDelete: Cascade)
  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([listId, courseId])
}

model SavedList {
  userId String
  listId String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  list   CollectionList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([userId, listId])
}

// ---------------------------------------------------------------
// Downloads + payments + system
// ---------------------------------------------------------------

model DownloadEvent {
  id        String   @id @default(cuid())
  userId    String?
  lessonId  String
  courseId  String
  quality   String?
  method    String   @default("app") // app | bot
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Subscription {
  id            String    @id @default(cuid())
  userId        String
  planName      String // 1_month | 3_months | 6_months
  paymentMethod String // telebirr | crypto | stripe | patreon
  amount        Float
  currency      String   @default("ETB")
  status        String   @default("pending") // pending | approved | rejected | expired
  txReference   String?
  periodStart   DateTime?
  periodEnd     DateTime?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentRefs   PaymentReference[]
}

model PaymentReference {
  id             String   @id @default(cuid())
  subscriptionId String
  reference      String
  verified       Boolean  @default(false)
  submittedAt    DateTime @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model TrendingQuery {
  query          String   @id
  count          Int      @default(1)
  lastSearchedAt DateTime @default(now())
}

model AppVersion {
  id           String   @id @default(cuid())
  version      String   @unique
  changelogMd  String
  releasedAt   DateTime @default(now())
}

// ---------------------------------------------------------------
// Telegram bot — group topic → course file serving
// ---------------------------------------------------------------

model TelegramCourseLink {
  id              String   @id @default(cuid())
  courseId        String   @unique
  chatId          BigInt
  chatUsername    String?
  messageThreadId BigInt? // forum topic id
  fileMessageId   BigInt
  fileId          String? // reusable Telegram file_id of the attached document
  fileName        String?
  fileSizeMb      Float?
  caption         String?
  createdById     String?
  createdAt       DateTime @default(now())
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// Persisted "last file this Telegram user sent/forwarded to the bot" so
// `/link <slug>` works even after the API instance restarts (Render free
// tier sleeps/redeploys wipe in-memory state).
model TelegramUserFile {
  userId     BigInt    @id
  fileId     String
  fileName   String?
  fileSizeMb Float?
  updatedAt  DateTime  @updatedAt
}

// Ring-buffer-ish log of the last bot events — surfaced via /telegram/status
// so link failures are diagnosable without Render log access.
model TelegramActivity {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  userId    BigInt?
  chatId    BigInt?
  kind      String // update | link | error | reply
  detail    String
}

// Persisted interactive wizard state (e.g. /newcourse) so a Render
// restart/redeploy mid-flow doesn't lose the user's progress.
model TelegramWizard {
  userId    BigInt   @id
  kind      String // course | search | download
  step      String
  data      Json
  messageId BigInt? // the bot's wizard bubble — edited in place each step
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

// Per-user navigation history (browser-style back/forward) so in-place
// edits never trap the user on a view they can't leave.
model TelegramNav {
  userId    BigInt   @id
  history   Json // [{ key, arg?, page? }]
  index     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model LegalDocument {
  id          String   @id @default(cuid())
  type        String   @unique // terms | privacy | refund
  version     String
  bodyMd      String
  effectiveAt DateTime @default(now())
}
