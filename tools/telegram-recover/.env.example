# Create your own app at https://my.telegram.org → API development tools.
# These identify the *client*, not the account; the phone login happens on first run.
TG_API_ID=
TG_API_HASH=

# The account that will do the forwarding. It must be able to read SOURCE and
# be a member (admin, to post) of DEST. Leave blank to be prompted on first run.
TG_PHONE=

# Your channel and the destination chat. Usernames or numeric ids (-100…).
SOURCE=@your_old_channel
DEST=@your_new_chat

# Only if DEST is a forum and you want the posts inside one topic.
# t.me/syncourse/824 → 824 is likely the topic's top-message id.
# DEST_TOPIC=824

# Seconds between forwards. New accounts should stay at 2 or higher.
DELAY=1.5
