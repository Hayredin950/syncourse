# ============================================================
# Syncourse — environment variables (copy to .env and fill in)
# The project runs out of the box with the defaults below
# (SQLite + demo JWT secret). Swap in real values for production.
# ============================================================

# --- Backend (apps/api) ---
# Database: SQLite (default, works locally) or PostgreSQL connection string
# e.g. postgresql://user:pass@host:5432/syncourse
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="dev-only-secret-change-me"
JWT_EXPIRES_IN="7d"

# Google OAuth ("Continue with Google" — web + mobile)
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# The exact redirect URI registered on the Google client (web flow):
GOOGLE_REDIRECT_URI="https://syncourse-api.vercel.app/api/auth/google/callback"
# The custom-scheme redirect registered for the mobile app (expo-auth-session):
GOOGLE_MOBILE_REDIRECT_URI="syncourse://auth"

# App URL (used for links/emails)
PUBLIC_APP_URL="http://localhost:3000"
API_PORT=4000

# --- Payments (fill in when you add real payment providers) ---
# Stripe (cards, worldwide)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Chapa (Ethiopian mobile money / Telebirr-style)
CHAPA_SECRET_KEY=""
CHAPA_PUBLIC_KEY=""

# Telegram bot (notifications + account linking)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="syncourse_bot"
# How the bot receives updates. Serverless (Vercel) can't hold the getUpdates
# long-poll, so there updates arrive over a webhook instead. Leave unset and
# the mode is inferred: webhook on Vercel, polling everywhere else.
# TELEGRAM_MODE="webhook"
# Optional explicit webhook URL — derived from VERCEL_PROJECT_PRODUCTION_URL
# when unset (must end in /api/telegram/webhook).
# TELEGRAM_WEBHOOK_URL=""
# Shared secret Telegram echoes back in x-telegram-bot-api-secret-token.
# Recommended whenever the webhook is public.
# TELEGRAM_WEBHOOK_SECRET=""

# --- Images: Cloudinary (course covers, avatars, note images) ---
# Images only — video stays on Cloudflare R2, never Cloudinary.
# Until these are set, the app serves image URLs untouched (no transform).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Client-side optimization (web): set at BUILD time so it gets inlined
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Client-side optimization (mobile/Expo):
# EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=""
TELEGRAM_CHANNELS="" # comma-separated channel handles for join-gate, e.g. "@mychannel1,@mychannel2"

# --- Web (apps/web) ---
# Base URL of the API the web app talks to
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (verification, receipts) ---
# Brevo (formerly Sendinblue) — 300 free emails/day, no card required
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@syncourse.app"
BREVO_SENDER_NAME="Syncourse"
