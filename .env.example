# ============================================================
# Syncourse — environment variables (copy to .env and fill in)
# The schema targets PostgreSQL; point DATABASE_URL at a local
# server or a Neon branch before running migrations.
# ============================================================

# --- Backend (apps/api) ---
# Database: PostgreSQL connection string
# e.g. postgresql://user:pass@host:5432/syncourse?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/syncourse"

# Auth
JWT_SECRET="dev-only-secret-change-me"
JWT_EXPIRES_IN="7d"

# Google OAuth ("Continue with Google" — web + mobile)
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# The exact redirect URI registered on the Google client (web flow):
GOOGLE_REDIRECT_URI="https://syncourse-api.vercel.app/api/auth/google/callback"
# The custom-scheme redirect registered for the mobile app (expo-auth-session):
GOOGLE_MOBILE_REDIRECT_URI="syncourse://auth"

# App URL (used for links/emails)
PUBLIC_APP_URL="http://localhost:3000"
# Other origins the same web build is served from, comma-separated. Google
# sign-in may only bounce back to an origin named here (or PUBLIC_APP_URL).
# Production serves the web app from Vercel.
PUBLIC_WEB_ORIGINS="https://syncourse-web.vercel.app"
API_PORT=4000

# --- Payments (fill in when you add real payment providers) ---
# Shared secret the provider (or the redirect handler) sends in the
# `x-webhook-secret` header to POST /payments/webhook/:provider/:id.
# Production fails closed when this is empty.
PAYMENTS_WEBHOOK_SECRET=""

# Stripe (cards, worldwide)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Chapa (Ethiopian mobile money / Telebirr-style)
CHAPA_SECRET_KEY=""
CHAPA_PUBLIC_KEY=""

# Telegram bot (notifications + account linking)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="syncourse_bot"
# How the bot receives updates. Serverless (Vercel) can't hold the getUpdates
# long-poll, so there updates arrive over a webhook instead. Leave unset and
# the mode is inferred: webhook on Vercel, polling everywhere else.
# TELEGRAM_MODE="webhook"
# Optional explicit webhook URL — derived from VERCEL_PROJECT_PRODUCTION_URL
# when unset (must end in /api/telegram/webhook).
# TELEGRAM_WEBHOOK_URL=""
# Shared secret Telegram echoes back in x-telegram-bot-api-secret-token.
# Recommended whenever the webhook is public.
# TELEGRAM_WEBHOOK_SECRET=""

# --- Images: Cloudinary (course covers, avatars, note images) ---
# Images only — video stays on Cloudflare R2, never Cloudinary.
# Until these are set, the app serves image URLs untouched (no transform).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Client-side optimization (web): set at BUILD time so it gets inlined
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Client-side optimization (mobile/Expo):
# EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=""
TELEGRAM_CHANNELS="" # comma-separated channel handles for join-gate, e.g. "@mychannel1,@mychannel2"

# --- Web (apps/web) ---
# Base URL of the API the web app talks to
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Email (verification, receipts) ---
# Brevo (formerly Sendinblue) — 300 free emails/day, no card required
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@syncourse.app"
BREVO_SENDER_NAME="Syncourse"

# --- Telegram group watcher (draft courses, human approval) ---
# Off switch for the whole watcher.
TELEGRAM_WATCHER_ENABLED="true"
# Which chats may create drafts. Comma-separated chat ids or @usernames.
TELEGRAM_SOURCE_CHATS=""
# Map a forum topic id to a catalogue category slug: 12:artificial-intelligence,14:web-development
TELEGRAM_TOPIC_CATEGORIES=""

# --- Large files (Phase 4, GitHub Actions only) ---
# The free Bot API refuses getFile above 20 MB. With these, the manual
# `index:large` job logs into MTProto as the same bot and downloads up to 2 GB.
# Get them from https://my.telegram.org → API development tools.
# NEVER put these in Vercel: they are only read by the Actions workflow.
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# --- Study assistant (Phase 5) ---
# Master switch. "false" turns the endpoint into a 503 and the web page says so.
ASSISTANT_ENABLED="true"
# gemini | groq | openrouter | none. Unset = the first configured key, in that
# order. "none" forces the no-AI answer even when keys exist.
ASSISTANT_LLM=""
# Free tier keys — pick one. Any single one enables written answers.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-flash-latest"
GROQ_API_KEY=""
# GROQ_MODEL="llama-3.3-70b-versatile"
OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# Per-day question budget, stored in the AssistantUsage table.
# ASSISTANT_DAILY_ANON="25"
# ASSISTANT_DAILY_USER="150"

